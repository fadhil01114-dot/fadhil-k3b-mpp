rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Health-check / connection test
    match /test/{docId} {
      allow read, write: if true;
    }

    // Admin Users Collection (for persistent enterprise admin accounts)
    match /admin_users/{userId} {
      allow read, write: if true;
    }

    // Master: Employees
    match /employees/{employeeId} {
      allow read, write: if true;
    }

    // Master: Departments
    match /departments/{departmentId} {
      allow read, write: if true;
    }

    // Master: Products
    match /products/{productId} {
      allow read, write: if true;
    }

    // Master: Clients & Vendors
    match /clients/{clientId} {
      allow read, write: if true;
    }

    // Transactions: Invoices
    match /sales_invoices/{invoiceId} {
      allow read, write: if true;
    }

    // Transactions: Expenses
    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    // Transactions: Payroll
    match /payrolls/{payrollId} {
      allow read, write: if true;
    }

    // Company profile
    match /company_profile/{profileId} {
      allow read, write: if true;
    }

    // Catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
